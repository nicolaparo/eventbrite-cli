<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>eventbrite</AssemblyName>
    <RootNamespace>EventbriteCli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>eventbrite</ToolCommandName>
    <PackageId>EventbriteCli</PackageId>
    <Version>0.1.0</Version>
    <Description>Read-only command line client for the Eventbrite Platform API v3.</Description>
    <Authors>Nicola Paro</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>eventbrite;cli;dotnet-tool</PackageTags>
    <RepositoryUrl>https://github.com/nicolaparo/eventbrite-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/nicolaparo/eventbrite-cli</PackageProjectUrl>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EventbriteCli.Tests" />
  </ItemGroup>

</Project>
